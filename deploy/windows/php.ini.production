; Copy these values into C:\php\php.ini for the Apache mod_php setup.
; The extension_dir path must match where PHP was extracted.

[PHP]
engine = On
expose_php = Off

extension_dir = "C:\php\ext"

extension = curl
extension = dom
extension = fileinfo
extension = gd
extension = intl
extension = mbstring
extension = openssl
extension = pdo_sqlite
extension = sqlite3
extension = xml
extension = xmlwriter
extension = zip

zend_extension = opcache

memory_limit = 512M
max_execution_time = 120
max_input_time = 120
max_input_vars = 5000

post_max_size = 20M
upload_max_filesize = 20M
max_file_uploads = 20

display_errors = Off
display_startup_errors = Off
log_errors = On
error_log = "C:\depot\storage\logs\php-error.log"
error_reporting = E_ALL

default_charset = "UTF-8"
date.timezone = "Africa/Casablanca"

output_buffering = 4096
realpath_cache_size = 4096K
realpath_cache_ttl = 600

cgi.fix_pathinfo = 0

[opcache]
opcache.enable = 1
opcache.enable_cli = 1
opcache.memory_consumption = 128
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files = 20000
opcache.validate_timestamps = 1
opcache.revalidate_freq = 2
